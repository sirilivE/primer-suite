{
  "name": "primer-suite",
  "version": "1.0.0",
  "description": "Primer design, primer binding check and multiplex primer-dimer analysis. Runs as a web app and as an offline desktop app.",
  "main": "electron/main.js",
  "author": "sirilivE (Aluthin Softwares)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node serve.js",
    "test": "node test/engine.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aluthin.primersuite",
    "productName": "Primer Suite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "maintainer": "Aluthin Softwares <siriwardanathilan@gmail.com>"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.medical"
    },
    "icon": "build/icon.png"
  },
  "homepage": "https://github.com/sirilivE/primer-suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/sirilivE/primer-suite.git"
  }
}
